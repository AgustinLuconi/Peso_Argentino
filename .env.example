# ==========================================
# Peso Argentino — Variables de Entorno
# ==========================================

# ------------------------------------------
# 1. Configuración del Backend (Render.com)
# ------------------------------------------
PORT=3001
NODE_ENV=development

# Google Gemini Flash Free Tier API Key (Google AI Studio)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui

# ------------------------------------------
# 2. Configuración del Frontend (Vercel.com)
# ------------------------------------------
# URL del backend en producción (en Render.com)
# Ejemplo: https://peso-argentino-backend.onrender.com
# En desarrollo local por defecto se utiliza: http://localhost:3001
VITE_API_URL=http://localhost:3001
